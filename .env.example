TAVUS_API_KEY=
TAVUS_PAL_ID=
TAVUS_FACE_ID=
OPENAI_API_KEY=
OPENAI_COACH_MODEL=gpt-5.6-terra

# Voix française native (facultatif, désactivé tant que les valeurs sont vides).
# Variables serveur uniquement : jamais de préfixe NEXT_PUBLIC_.
# Sans elles, la voix Tavus Auto reste utilisée.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL_ID=

# Base de données PostgreSQL (fournie par IridFlow via l'attache de base).
# Le schéma se crée seul au premier accès.
DB_URL=

# Comptes créés uniquement si la table users est vide (premier démarrage).
SEED_MANAGER_EMAIL=
SEED_MANAGER_PASSWORD=
SEED_COMMERCIAL_EMAIL=
SEED_COMMERCIAL_PASSWORD=
